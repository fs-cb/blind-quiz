rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /sessions/{sessionId} {
      allow read:   if true;
      allow create: if true;
      allow update: if request.resource.data.adminToken == resource.data.adminToken;
      allow delete: if true;

      match /answers/{userId} {
        allow read:   if true;
        allow delete: if true;

        // entry・answering中のみ書き込み可（closed・revealed後は不可）
        allow write: if request.auth != null
          && request.auth.uid == userId
          && (
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.status == 'entry'
            ||
            get(/databases/$(database)/documents/sessions/$(sessionId)).data.status == 'answering'
          );
      }
    }
  }
}
